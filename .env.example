# Copy to .env for local runs, or paste these into your host's environment settings.
# On Hugging Face Spaces: Settings -> Variables and secrets -> New secret.

# Where SQLite, extracted text, fingerprints and job results are stored.
DATA_DIR=./data

# --- Live web plagiarism checking (optional) -------------------------------
